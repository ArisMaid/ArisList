APP_PORT=8787
ARISLIST_IMAGE=ghcr.io/arismaid/arislist:latest
DATABASE_URL=sqlite:///app/data/library.sqlite
APP_BIND=0.0.0.0:8787
COMICS_DIR=/library/comics
NOVELS_DIR=/library/novels
AUDIO_DIR=/library/audio
GALLERY_DIR=/library/gallery
COSER_PICTURE_DIR=/library/coser-picture
GENERATED_DIR=/app/generated
CLOUD_CACHE_MAX_BYTES=68719476736
THUMBNAIL_CACHE_MAX_BYTES_PER_DIR=8589934592
CATALOG_V2_ENABLED=true
FACET_BITMAP_ENABLED=false
INVENTORY_SCANNER_ENABLED=false
# When Inventory is enabled, leave empty/all for compatibility or select a
# comma-separated rollout subset such as novel,comic.
INVENTORY_SCANNER_KINDS=all
SEARCH_OUTBOX_SHADOW_ENABLED=false
SEARCH_SHADOW_CANARY_ENABLED=false
SEARCH_INCREMENTAL_READER_ENABLED=false
SEARCH_READER_PREWARM_ENABLED=false
DERIVATIVE_CACHE_V2_ENABLED=false
JPEG_THUMBNAIL_DOWNSCALE_ENABLED=false
DERIVATIVE_CACHE_DIR=/app/data/derivatives
DERIVATIVE_CACHE_MAX_BYTES=34359738368
DERIVATIVE_CACHE_LOW_WATERMARK_BYTES=30064771072
RESOURCE_PROFILE=nas-n100-4g
SQLITE_MAX_CONNECTIONS=5
SQLITE_CACHE_KIB_PER_CONNECTION=24576
SQLITE_MMAP_SIZE_BYTES=67108864
SQLITE_BUSY_TIMEOUT_MILLIS=10000
SQLITE_ACQUIRE_TIMEOUT_MILLIS=10000
SQLITE_WAL_AUTOCHECKPOINT_PAGES=4000
SQLITE_JOURNAL_SIZE_LIMIT_BYTES=268435456
SQLITE_WRITER_QUEUE_MAX_DEPTH=32
SQLITE_WRITER_QUEUE_MAX_BYTES=67108864
PROCESSING_MEMORY_BUDGET_BYTES=1073741824
INFLIGHT_MEDIA_BUDGET_BYTES=268435456
MEMORY_SOFT_LIMIT_BYTES=3221225472
MEMORY_RESUME_LIMIT_BYTES=2818572288
ARCHIVE_MANIFEST_CACHE_BYTES=268435456
RESOURCE_WAIT_TIMEOUT_MILLIS=10000
THUMBNAIL_WORKERS=1
ARCHIVE_STREAM_WORKERS=2
LOCAL_MEDIA_STREAM_WORKERS=2
SCAN_IO_CONCURRENCY=1
SEARCH_WRITER_HEAP_BYTES=33554432
COVER_CACHE_DIR=/app/cover-cache
# Leave these unset to use subdirectories below COVER_CACHE_DIR.
# COMIC_COVER_CACHE_DIR=/app/cover-cache/comic
# NOVEL_COVER_CACHE_DIR=/app/cover-cache/novel
# AUDIO_COVER_CACHE_DIR=/app/cover-cache/audio
# GALLERY_COVER_CACHE_DIR=/app/cover-cache/gallery
# COSER_PICTURE_COVER_CACHE_DIR=/app/cover-cache/coser-picture
LIGHTNOVEL_API_BASES=https://api.lightnovel.life,https://cf-api.lightnovel.life
LIGHTNOVEL_ACCESS_TOKEN=
ENRICHMENT_CONCURRENCY=1
ENABLE_FILE_WATCHER=false
WATCH_DEBOUNCE_SECONDS=20
EHTT_URL=https://fastly.jsdelivr.net/gh/EhTagTranslation/DatabaseReleases/db.html.json
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
QMEDIASYNC_BASE_URL=
QMEDIASYNC_STRM_DIR=./qms-strm
# STRM remote request governance. Defaults to one real request per second and
# five manual redirects. Keep these empty unless a private/NAS origin is
# intentionally part of the deployment.
REMOTE_SOURCE_WORKERS=1
STRM_MIN_REQUEST_INTERVAL_MS=1000
STRM_MAX_REDIRECTS=5
STRM_TRUSTED_ORIGINS=
STRM_TRUSTED_NETWORKS=
# Optional fixed 7-Zip executable for RAR/7z entry preparation.
STRM_7ZIP_PATH=7z

# STRM original comic-page disk cache (512 MiB; LRU + 24h idle expiration)
STRM_PAGE_CACHE_MAX_BYTES=536870912
